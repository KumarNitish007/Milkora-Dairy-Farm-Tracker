<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Milkora.API</RootNamespace>
    <!-- Server GC favours throughput for a server workload. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <!-- NOTE: InvariantGlobalization must stay OFF — Microsoft.Data.SqlClient
         requires ICU globalization to open a connection. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <!-- Dotmim.Sync server side: SQL Server provider + web server orchestrator. -->
    <PackageReference Include="Dotmim.Sync.SqlServer" Version="1.3.0" />
    <PackageReference Include="Dotmim.Sync.Web.Server" Version="1.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Composition root: references Application (contracts + services) and
         Infrastructure (implementations) purely to wire up DI. -->
    <ProjectReference Include="..\Milkora.Application\Milkora.Application.csproj" />
    <ProjectReference Include="..\Milkora.Infrastructure\Milkora.Infrastructure.csproj" />
    <ProjectReference Include="..\Milkora.Sync\Milkora.Sync.csproj" />
  </ItemGroup>

</Project>
