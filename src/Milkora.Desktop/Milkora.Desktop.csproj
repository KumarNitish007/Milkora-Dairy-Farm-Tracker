<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Milkora.Desktop</RootNamespace>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <!-- Must stay off: Microsoft.Data.Sqlite (the sync engine) requires ICU globalization. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- The referenced API brings a duplicate appsettings.json; the target below
         removes the API's copies, so downgrade the duplicate check to allow it. -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>
  <ItemGroup>
    <!-- Electron.NET wrapper: opens a Chromium window over the local Kestrel host. -->
    <PackageReference Include="ElectronNET.API" Version="23.6.2" />
    <!-- Sync server endpoint (same as the standalone API). -->
    <PackageReference Include="Dotmim.Sync.SqlServer" Version="1.3.0" />
    <PackageReference Include="Dotmim.Sync.Web.Server" Version="1.3.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Reuse the whole stack: API controllers (via ApplicationPart), the layers,
         shared sync setup, and the device sync engine. -->
    <ProjectReference Include="..\Milkora.API\Milkora.API.csproj" />
    <ProjectReference Include="..\Milkora.Application\Milkora.Application.csproj" />
    <ProjectReference Include="..\Milkora.Infrastructure\Milkora.Infrastructure.csproj" />
    <ProjectReference Include="..\Milkora.Sync\Milkora.Sync.csproj" />
    <ProjectReference Include="..\Milkora.SyncClient\Milkora.SyncClient.csproj" />
  </ItemGroup>
  <!-- Milkora.API is referenced only for its controllers; drop its appsettings*.json
       from publish so they don't collide with this host's own (NETSDK1152). -->
  <Target Name="DropReferencedApiAppsettings" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('appsettings')) and $([System.String]::Copy('%(ResolvedFileToPublish.FullPath)').Contains('Milkora.API'))" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <Content Update="electron.manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>