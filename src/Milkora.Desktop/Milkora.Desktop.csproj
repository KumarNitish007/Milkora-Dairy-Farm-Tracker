<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Milkora.Desktop</RootNamespace>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <!-- Must stay off: Microsoft.Data.Sqlite (the sync engine) requires ICU globalization. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Electron.NET wrapper: opens a Chromium window over the local Kestrel host. -->
    <PackageReference Include="ElectronNET.API" Version="23.6.2" />
    <!-- Sync server endpoint (same as the standalone API). -->
    <PackageReference Include="Dotmim.Sync.SqlServer" Version="1.3.0" />
    <PackageReference Include="Dotmim.Sync.Web.Server" Version="1.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reuse the whole stack: API controllers (via ApplicationPart), the layers,
         shared sync setup, and the device sync engine. -->
    <ProjectReference Include="..\Milkora.API\Milkora.API.csproj" />
    <ProjectReference Include="..\Milkora.Application\Milkora.Application.csproj" />
    <ProjectReference Include="..\Milkora.Infrastructure\Milkora.Infrastructure.csproj" />
    <ProjectReference Include="..\Milkora.Sync\Milkora.Sync.csproj" />
    <ProjectReference Include="..\Milkora.SyncClient\Milkora.SyncClient.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="electron.manifest.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
  </ItemGroup>

</Project>
