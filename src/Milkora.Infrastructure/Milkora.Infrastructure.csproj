<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Milkora.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pure ADO.NET. NO Entity Framework. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Infrastructure implements Domain's repository interfaces => depends on Domain only. -->
    <ProjectReference Include="..\Milkora.Domain\Milkora.Domain.csproj" />
  </ItemGroup>

</Project>
